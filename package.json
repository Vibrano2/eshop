{
  "name": "eshop-store-eu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "build:all": "npm run build",
    "package:cpanel": "npx vite build && node scripts/package-cpanel.js",
    "seed": "node server/seed.js",
    "test": "node --test server/test/api.test.js",
    "test:catalog": "node scripts/audit_full_catalog_checkout.js",
    "test:all": "npm run test && npm run test:catalog",
    "ci": "npm run test && npm run test:catalog && npm run build"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.16.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.16.0",
    "nodemailer": "^10.0.1",
    "pdfkit": "^0.20.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.2.0"
  }
}
