# ==============================================================================
# eShop Store - Environment Configuration Template (.env.example)
# IMPORTANT: Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit .env or genuine private secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Configuration (Backend)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=production
CLIENT_URL=http://localhost:5173,https://eshopstore.shop
DATABASE_FILE=server/eshop.db

# ------------------------------------------------------------------------------
# 2. Server Secrets (PRIVATE - NEVER EXPOSE TO FRONTEND)
# ------------------------------------------------------------------------------
# Session signature secret (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace_with_a_secure_random_64_character_hex_string

# Internal Administrative API Key for automated operations
ADMIN_API_KEY=replace_with_a_secure_admin_api_key

# ------------------------------------------------------------------------------
# 3. Payment Processing - Stripe
# ------------------------------------------------------------------------------
# Stripe Secret Key (PRIVATE - Server-only, starts with sk_live_ or sk_test_)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key

# Stripe Publishable Key (PUBLIC - Safe for frontend use, starts with pk_live_ or pk_test_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key

# Stripe Webhook Signing Secret (PRIVATE - Server-only, starts with whsec_)
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 4. Email Services - Resend or SMTP (PRIVATE - Server-only)
# ------------------------------------------------------------------------------
# Resend API Key (starts with re_)
RESEND_API=re_replace_with_your_resend_api_key
RESEND_FROM="eShop France" <commandes@eshopstore.shop>

# Fallback SMTP Configuration (e.g., Gmail App Password, SendGrid, Amazon SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@eshopstore.shop
SMTP_PASS=replace_with_your_smtp_password_or_app_password
SMTP_FROM="eShop France" <contact@eshopstore.shop>

# ------------------------------------------------------------------------------
# 5. Firebase Web Configuration (PUBLIC CLIENT CONFIGURATION)
# These values identify your Firebase project to the Firebase SDK in browser code.
# Security is enforced by Firebase Authentication, Firestore Security Rules, and Storage Rules.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSy_replace_with_your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=eshop-16b88.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=eshop-16b88
VITE_FIREBASE_STORAGE_BUCKET=eshop-16b88.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=952885151547
VITE_FIREBASE_APP_ID=1:952885151547:web:bbb79c7b93ae5ab058191e

# Optional: Firebase App Check reCAPTCHA v3 site key (Public client key)
VITE_FIREBASE_APPCHECK_KEY=

# ------------------------------------------------------------------------------
# 6. Public Site Configuration (Frontend)
# ------------------------------------------------------------------------------
VITE_SITE_URL=https://eshopstore.shop
VITE_API_URL=/api
