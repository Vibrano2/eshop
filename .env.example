# Configuration de l'environnement eshop-store.eu

# Port d'écoute du serveur Node / Express (injecté automatiquement sur Cloud Run / Render / Railway)
PORT=3001

# Environnement (géré par Node / Docker, laisser vide ou commenter en dev avec Vite)
# NODE_ENV=production

# URL d'origine acceptée pour CORS en développement
CLIENT_URL=http://localhost:5173

# Emplacement de la base SQLite
DATABASE_FILE=server/eshop.db

# Clés de sécurité et administration
SESSION_SECRET=eshop-secret-super-secure-key-2026
ADMIN_API_KEY=admin-secret-eshop-2026

# Configuration passerelle de paiement Stripe Sandbox
STRIPE_SECRET_KEY=sk_test_placeholder_eshop

# Configuration Email SMTP (Ethereal pour dev/test ou SendGrid/Resend pour production)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Configuration Firebase Web App
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=eshop-16b88.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=eshop-16b88
VITE_FIREBASE_STORAGE_BUCKET=eshop-16b88.firebasestorage.app
