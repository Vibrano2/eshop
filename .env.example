# ==============================================================================
# Configuration de l'environnement eshopstore.shop
# ==============================================================================

# Port d'écoute du serveur Node / Express (injecté automatiquement sur Cloud Run / Render / Railway)
PORT=3001

# Environnement ('development' ou 'production')
NODE_ENV=development

# URL du client web pour la politique CORS
CLIENT_URL=http://localhost:5173

# Emplacement du fichier de base de données SQLite
DATABASE_FILE=server/eshop.db

# Clés de sécurité de session et administration
SESSION_SECRET=eshop-secret-super-secure-key-2026
ADMIN_API_KEY=admin-secret-eshop-2026

# ==============================================================================
# Passerelle de paiement Stripe
# ==============================================================================
# Clé secrète backend Stripe
STRIPE_SECRET_KEY=sk_test_placeholder_eshop
# Clé publique frontend Stripe (pour le client Vite)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_eshop

# ==============================================================================
# Service d'envoi d'emails transactionnels (SMTP)
# Laissez vide pour utiliser automatiquement la boîte de test sandbox Ethereal
# ==============================================================================
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="eshopstore.shop" <commandes@eshopstore.shop>

# Compatibilité avec la convention EMAIL_*
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ==============================================================================
# Variables Frontend Vite
# ==============================================================================
# URL canonique publique du site
VITE_SITE_URL=https://eshopstore.shop
# URL de l'API backend (laisser '/api' si servi par le serveur Express unifié)
VITE_API_URL=/api

# Firebase Web App (Authentication, Google/Apple OAuth, Firestore)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=eshop-16b88.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=eshop-16b88
VITE_FIREBASE_STORAGE_BUCKET=eshop-16b88.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=952885151547
VITE_FIREBASE_APP_ID=1:952885151547:web:bbb79c7b93ae5ab058191e
