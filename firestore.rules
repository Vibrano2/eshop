rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isEmailOwner(email) {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             email != null &&
             request.auth.token.email.lower() == email.lower();
    }

    function isAdmin() {
      return isAuthenticated() &&
             (request.auth.token.admin == true ||
              request.auth.token.role == 'admin');
    }

    // 1. Users collection: Customers can only read and manage their own profile
    // Role privilege escalation is strictly forbidden
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId) &&
                       (!('role' in request.resource.data) || request.resource.data.role == 'customer');

      allow update: if isOwner(userId) &&
                       (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // 2. Orders collection: Customers can only view and create their own orders
    match /orders/{orderId} {
      allow read: if isEmailOwner(resource.data.customer_email) ||
                     (isAuthenticated() && 'userId' in resource.data && resource.data.userId == request.auth.uid) ||
                     isAdmin();

      allow create: if isEmailOwner(request.resource.data.customer_email) ||
                       (isAuthenticated() && 'userId' in request.resource.data && request.resource.data.userId == request.auth.uid) ||
                       isAdmin();

      allow update, delete: if isAdmin();
    }

    // 3. Product Reviews: Publicly viewable, write requires authentication
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
                       (!('author_email' in request.resource.data) || isEmailOwner(request.resource.data.author_email));

      allow update: if isAuthenticated() &&
                       'author_email' in resource.data &&
                       isEmailOwner(resource.data.author_email);

      allow delete: if isAdmin();
    }

    // 4. Products catalog: Publicly viewable, modification restricted to Admin
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Default Deny: All unspecified paths are closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
